# Fish Social — environment template (copy to .env and adjust)
# Used by: local dev, docker compose, production deploy

# --- Server ---
PORT=3001
NODE_ENV=development
# DB_PATH=data/fish-social.db
# SHUTDOWN_TIMEOUT_MS=8000

# --- Auth (production: JWT_SECRET required; dev can use AUTH_DISABLED=1) ---
JWT_SECRET=dev-secret-change-me
# AUTH_DISABLED=1
# 注册/鉴权说明见 docs/ops/auth-register.md

# --- Steam desktop auth ---
# Keep the Web API key on the Node server only. Never copy it to Unity.
STEAM_AUTH_ENABLED=false
STEAM_APP_ID=
STEAM_WEB_API_KEY=
STEAM_AUTH_IDENTITY=fish-social-server-v1

# --- Local-only fishing verification ---
# instant = 1s bite tick, 100% bite, 0% escape; ignored when NODE_ENV=production.
FISHING_TEST_MODE=

# --- CORS (production: comma-separated origins; REQUIRED — no *; compose has no default *) ---
# ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
# Full env catalog: docs/ops/server-env.md

# --- Admin ---
ADMIN_SECRET=dev-admin-secret-change-me
# STAB-05: production REST rejects ?key= unless true; SSE /api/admin/live-session always allows query
# ADMIN_ALLOW_QUERY_KEY=false
# SEC-06: required when NODE_ENV=production (player erase / metrics anonymize)
PLAYER_ERASE_PEPPER=dev-erase-pepper-change-me
# ADMIN_RBAC_RULES=
# ADMIN_ROUTE_SLOW_MS=200

# --- Client / Expo ---
EXPO_WEB_PORT=8082

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs
LOG_PRETTY=1
LOG_TO_FILE=0
# QUAL-08: production defaults to mask playerId/nickname; set false to disable
# LOG_MASK_USER_DATA=false

# --- Ops static (QUAL-07) ---
# Serve /planning /ops /analytics on API port. Public hosts: set false.
# OPS_STATIC_ENABLED=true

# --- Loki (optional) ---
LOKI_ENABLED=false
LOKI_HOST=http://localhost:3100
# LOKI_BASIC_AUTH=
# LOKI_LABEL_SERVICE=fish-social-server

# --- Prometheus metrics (optional) ---
METRICS_PROMETHEUS_ENABLED=false

# --- Alerts (optional) ---
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TYPE=generic

# --- Data retention / perf ---
ERROR_LOG_RETENTION_DAYS=90
METRICS_RETENTION_DAYS=90
DB_BACKUP_RETAIN=7
SLOW_QUERY_MS=30
PERF_LOG_INTERVAL_MS=30000
# OBS-LOG-1: perf info only when durationMs >= PERF_LOG_SLOW_MS (or PERF_LOG_INFO=1 for interval sampling)
# PERF_LOG_SLOW_MS=50
# PERF_LOG_INFO=0
# ECOLOGY_VERBOSE=0
# FANOUT_LOG_INFO=0
# SOCKET_TAP_IGNORE_EVENTS=session_timer_tick,pond_ecology_updated
# SOCKET_TAP_INCLUDE_TIMER=0

# --- OpenTelemetry (D-L1-10, optional) ---
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# OTEL_SERVICE_NAME=fish-social-server

# --- Socket event tap (D-L1-12) ---
SOCKET_TAP_SAMPLE_RATE=0.01
# SOCKET_TAP_PAYLOAD_MAX=512
# OBS-LOG-1: ignore high-frequency out events (comma-separated); empty = tap all
# SOCKET_TAP_IGNORE_EVENTS=session_timer_tick,pond_ecology_updated
# SOCKET_TAP_INCLUDE_TIMER=1  # keep ignoring ecology but tap session_timer_tick

# --- Metrics storage (D-L2-04 / QUAL-03, optional PG) ---
# METRICS_PG_URL=postgresql://user:pass@localhost:5432/fish_social
# METRICS_DUAL_WRITE=true
# METRICS_READ_FROM=sqlite   # only sqlite; postgres reads refused at startup
# See docs/ops/server-env.md

# --- Bite tick detail (D-L2-15) ---
# Default: do NOT write bite_tick_miss/hit rows; counters ride on bite_hook/escape.
# METRICS_BITE_TICK_PERSIST=0
# METRICS_BITE_TICK_PERSIST=1   # restore per-tick rows for tuning / debug
# D-L2-16: skip metrics for playerId starting with bot-
# METRICS_SKIP_BOTS=1

# --- Security (ARC-10) ---
# MAX_SOCKET_CONNECTIONS=200
# RATE_LIMIT_GLOBAL_PER_SEC=100
# RATE_LIMIT_AUTH_PER_MIN=10
# STAB-04: per-socket budget for join_pond / chat / fishing events
# SOCKET_EVENT_RATE_PER_SEC=20

# --- Human capacity (R2-3) ---
# Soft-reject new human join_pond when bound humans >= limit. Bots exempt.
MAX_HUMAN_SOCKETS=200
# MAX_HUMANS_PER_POND=   # optional; empty = no extra per-pond human cap

# --- Bot spawn pace (FISH-BOT-2; also in game_config) ---
# BOT_BOOT_MIN=3
# BOT_BOOT_MAX=6
# BOT_SPAWN_CHECK_MS=45000
# BOT_SPAWN_CHANCE=0.35
# BOT_BOOT_FISHING_RATIO=0.75
# BOT_JOIN_FISHING_CHANCE=0.4

# JWT_SECRET and ADMIN_SECRET must be set — see values above

# --- Art / ComfyUI (local; never commit real keys) ---
# Running instance path on this machine (update if yours differs):
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_ROOT=F:/ComfyUI_windows_portable/ComfyUI
COMFYUI_OUTPUT_DIR=F:/ComfyUI_windows_portable/ComfyUI/output
OPENAI_API_KEY=
# Optional OpenAI-compatible gateway
# OPENAI_BASE_URL=https://api.openai.com
