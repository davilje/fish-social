<Window x:Class="FishSocialOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fish Social Overlay"
        Width="480"
        Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Grid Background="Transparent">
        <Border x:Name="PetPanel"
                Width="300"
                Height="330"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#E61B2633"
                CornerRadius="18"
                MouseLeftButtonDown="PetPanel_OnMouseLeftButtonDown"
                MouseMove="PetPanel_OnMouseMove"
                MouseLeftButtonUp="PetPanel_OnMouseLeftButtonUp">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主界面" Click="OpenMain_OnClick" />
                    <MenuItem Header="隐藏 Overlay" Click="HideOverlay_OnClick" />
                    <Separator />
                    <MenuItem Header="退出 Overlay" Click="QuitOverlay_OnClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="220" Height="220">
                    <Polygon Points="48,70 68,18 103,62"
                             Fill="#FF4D89A8"
                             Stroke="#FFB8E1EF"
                             StrokeThickness="3" />
                    <Polygon Points="117,62 152,18 172,70"
                             Fill="#FF4D89A8"
                             Stroke="#FFB8E1EF"
                             StrokeThickness="3" />
                    <Ellipse Width="150" Height="145"
                             Canvas.Left="35"
                             Canvas.Top="52"
                             Fill="#FF4D89A8"
                             Stroke="#FFB8E1EF"
                             StrokeThickness="3" />
                    <Ellipse Width="16" Height="22"
                             Canvas.Left="76"
                             Canvas.Top="102"
                             Fill="#FF16212B" />
                    <Ellipse Width="16" Height="22"
                             Canvas.Left="128"
                             Canvas.Top="102"
                             Fill="#FF16212B" />
                    <Ellipse Width="12" Height="8"
                             Canvas.Left="104"
                             Canvas.Top="139"
                             Fill="#FFF3C969" />
                </Canvas>
                <TextBlock x:Name="StateText"
                           Text="状态：等待主界面"
                           Foreground="White"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4" />
                <TextBlock x:Name="PondText"
                           Text="鱼塘：未连接"
                           Foreground="#FFD4E3EA"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />
                <Button Content="打开主界面"
                        Width="120"
                        Height="30"
                        Click="OpenMain_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
