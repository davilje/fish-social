<Window x:Class="FishSocialOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FishSocialOverlay"
        Title="Fish Social Overlay"
        Width="960"
        Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        ShowActivated="False"
        MouseLeave="Window_OnMouseLeave">
    <Window.Resources>
        <Style x:Key="HudChatScrollBarStyle" TargetType="ScrollBar" BasedOn="{StaticResource CozyScrollBar}" />
    </Window.Resources>
    <Grid Background="Transparent">
        <Border x:Name="PondScene"
                Width="960"
                Height="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                ClipToBounds="False"
                Background="Transparent"
                MouseLeftButtonDown="PondScene_OnMouseLeftButtonDown"
                MouseMove="PondScene_OnMouseMove"
                MouseLeave="PondScene_OnMouseLeave"
                MouseLeftButtonUp="PondScene_OnMouseLeftButtonUp"
                PreviewMouseRightButtonDown="PondScene_PreviewMouseRightButtonDown"
                PreviewMouseRightButtonUp="PondScene_PreviewMouseRightButtonUp">
            <!-- Product menu is NOT attached to Border.ContextMenu — attaching it makes
                 WPF sticky after the first open and steals later pet social menus. -->
            <Canvas x:Name="SceneCanvas" Width="960" Height="560">
                <!-- Z0–10: 场景层。视口宿主跟窗口走（STEAM-DESKTOP-16）；SceneContentCanvas 保持塘像素尺寸。
                     上下渐隐在 SceneFadeHost；左右渐隐在 ScenePanViewport（二者不可叠同一元素）。
                     横移 + 切顶由 TranslateTransform 完成，禁止整窗 Scale/Viewbox。HUD 为兄弟不参与渐隐。 -->
                <Border x:Name="SceneFadeHost"
                        Canvas.Left="0"
                        Canvas.Top="0"
                        Width="960"
                        Height="560"
                        Panel.ZIndex="0"
                        Background="{x:Null}"
                        ClipToBounds="True">
                    <Border x:Name="ScenePanViewport"
                            Width="960"
                            Height="560"
                            Background="{x:Null}"
                            ClipToBounds="True">
                        <Canvas x:Name="SceneContentCanvas"
                                Width="960"
                                Height="560"
                                Background="{x:Null}">
                            <Image x:Name="PondBackgroundImage"
                                   Width="960"
                                   Height="560"
                                   Stretch="Fill"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"
                                   Panel.ZIndex="0" />
                            <Rectangle x:Name="GrassLayer"
                                       Width="960"
                                       Height="560"
                                       Fill="#E62F4A3A"
                                       Panel.ZIndex="0" />
                            <Ellipse x:Name="ShoreLayer"
                                     Width="760"
                                     Height="400"
                                     Canvas.Left="100"
                                     Canvas.Top="80"
                                     Fill="#CC8B6A45"
                                     Panel.ZIndex="0" />
                            <Ellipse x:Name="WaterLayer"
                                     Width="700"
                                     Height="360"
                                     Canvas.Left="130"
                                     Canvas.Top="100"
                                     Fill="#CC2A6F8F"
                                     Panel.ZIndex="0" />
                            <Canvas x:Name="DecorLayer" Width="960" Height="560" Panel.ZIndex="2" IsHitTestVisible="False" />
                            <Canvas x:Name="SpotLayer" Width="960" Height="560" Panel.ZIndex="5" />
                            <Viewbox x:Name="OwnCat"
                                     Width="64"
                                     Height="64"
                                     Canvas.Left="448"
                                     Canvas.Top="320"
                                     Stretch="Uniform"
                                     Visibility="Collapsed"
                                     Panel.ZIndex="10" />
                            <Image x:Name="OwnCatImage"
                                   Width="64"
                                   Height="64"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"
                                   Panel.ZIndex="10" />
                            <Canvas x:Name="ActorLayer" Width="960" Height="560" Panel.ZIndex="10" />
                        </Canvas>
                    </Border>
                </Border>
                <!-- Z50+: HUD / 交互层（不参与边缘渐隐） -->
                <Canvas x:Name="HoverLayer" Width="960" Height="560" Panel.ZIndex="50" IsHitTestVisible="False" />
                <Canvas x:Name="ChatBubbleLayer" Width="960" Height="560" Panel.ZIndex="55" IsHitTestVisible="False" />
                <!-- Z120: 场景横移箭头（HUD JSON 可覆盖位置；默认隐藏，宽场景显示） -->
                <Button x:Name="BtnPanLeft" Style="{StaticResource CozyInteractionButton}" local:CozyInteractionGlyph.Kind="left" Padding="0"
                        Canvas.Left="16"
                        Canvas.Top="247"
                        Width="44"
                        Height="44"
                        Panel.ZIndex="120"
                        Content="向左"
                        FontSize="10"
                        Visibility="Collapsed"
                        Background="Transparent"
                        Foreground="{StaticResource CozyInk}"
                        BorderThickness="0"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.pan_left" />
                <Button x:Name="BtnPanRight" Style="{StaticResource CozyInteractionButton}" local:CozyInteractionGlyph.Kind="right" Padding="0"
                        Canvas.Left="900"
                        Canvas.Top="247"
                        Width="44"
                        Height="44"
                        Panel.ZIndex="120"
                        Content="向右"
                        FontSize="10"
                        Visibility="Collapsed"
                        Background="Transparent"
                        Foreground="{StaticResource CozyInk}"
                        BorderThickness="0"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.pan_right" />
                <!-- Z110: unused (guide lives on ChatBubbleLayer above the pet) -->
                <Border x:Name="GuideTipChrome"
                        Canvas.Left="120"
                        Canvas.Top="12"
                        Width="720"
                        Panel.ZIndex="110"
                        local:CozyTheme.IsPaper="True"
                        CornerRadius="10"
                        Padding="12,8"
                        Visibility="Collapsed"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="GuideTipText"
                               Text=""
                               Foreground="{StaticResource CozyInk}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />
                </Border>
                <!-- Z100: 右下状态（HUD JSON 激活后整组隐藏；菜单只走右键） -->

                <TextBlock x:Name="ErrorText" Canvas.Left="16" Canvas.Top="16" Width="928"
                           Foreground="{StaticResource CozyInk}" FontSize="12" TextWrapping="Wrap"
                           IsHitTestVisible="False" />
                <StackPanel x:Name="LegacyLeftHudStack"
                            Canvas.Right="112"
                            Canvas.Bottom="12"
                            Panel.ZIndex="100"
                            Width="196">
                    <Button x:Name="MenuToggleButton" local:CozyTheme.Icon="cozy/icons-light/settings.png"
                            Content="" ToolTip="菜单"
                            Width="36"
                            Height="32"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="MenuToggle_OnClick" />
                    <Border x:Name="MenuPanel"
                            Visibility="Collapsed"
                            local:CozyTheme.IsPaper="True"
                            CornerRadius="8"
                            Padding="6"
                            Margin="0,4,0,0">
                        <StackPanel>
                            <Button x:Name="MenuMapButton" local:CozyTheme.Icon="cozy/icons-light/map.png" Content="世界地图" ToolTip="世界地图" Height="32" Margin="0,0,0,4" Click="MenuMap_OnClick" />
                            <Button x:Name="MenuShopButton" local:CozyTheme.Icon="cozy/icons-light/shop.png" Content="商店与装备" ToolTip="商店与装备" Height="32" Margin="0,0,0,4" Click="MenuShop_OnClick" />
                            <Button x:Name="MenuFriendsButton" local:CozyTheme.Icon="cozy/icons-light/social.png" Content="好友与聊天" ToolTip="好友与聊天" Height="32" Margin="0,0,0,4" Click="MenuFriends_OnClick" />
                            <Button x:Name="MenuCatchButton" local:CozyTheme.Icon="cozy/icons-light/bag.png" Content="鱼获/背包" ToolTip="鱼获/背包" Height="32" Margin="0,0,0,4" Click="MenuCatch_OnClick" />
                            <Button x:Name="MenuLeaderboardButton" local:CozyTheme.Icon="cozy/icons-light/trophy.png" Content="排行榜" ToolTip="排行榜" Height="32" Margin="0,0,0,4" Click="MenuLeaderboard_OnClick" />
                            <Button x:Name="MenuSettingsButton" local:CozyTheme.Icon="cozy/icons-light/settings.png" Content="设置" ToolTip="设置" Height="32" Click="MenuSettings_OnClick" />
                            <Button Content="导出 HUD JSON" Height="32" Margin="0,4,0,0" local:CozyTheme.Icon="cozy/icons-light/settings.png" Click="ExportHudJson_OnClick" />
                        </StackPanel>
                    </Border>

                </StackPanel>
                <!-- Z100: 右下角 — Debug（只调宽度）+ 退出鱼塘；打开主界面改走右键菜单 -->
                <StackPanel x:Name="LegacyRightTopHudStack"
                            Canvas.Right="16"
                            Canvas.Bottom="12"
                            Panel.ZIndex="100">
                    <Button x:Name="PoliceDebugButton" local:CozyTheme.Icon="cozy/icons-light/bell.png"
                            Content="一键出警"
                            Width="88"
                            Height="36"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Background="{StaticResource CozyCoral}"
                            Foreground="{StaticResource CozyInk}"
                            Click="PoliceDebug_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.summon_patrol" />
                    <Button x:Name="GameplayDebugButton" local:CozyTheme.Icon="cozy/icons-light/settings.png"
                            Content="Debug"
                            Width="88"
                            Height="36"
                            Margin="0,0,0,8"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Background="{StaticResource CozyPeriwinkle}"
                            Foreground="{StaticResource CozyInk}"
                            Click="GameplayDebug_OnClick" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenMainButton" local:CozyTheme.Icon="cozy/icons-light/home.png"
                                Content="打开主界面"
                                Width="100"
                                Height="40"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="OpenMain_OnClick" />
                        <Button x:Name="ExitPondButton" Style="{StaticResource CozyInteractionButton}" local:CozyInteractionGlyph.Kind="leave" local:CozyTheme.Icon="cozy/icons-light/lock.png"
                                Content="退出鱼塘"
                                FontSize="13"
                                Width="112"
                                Height="40"
                                Click="ExitPond_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.exit_pond" />
                    </StackPanel>
                </StackPanel>
                <!-- Z100: 底部居中 — 打窝 / 开始钓鱼 / 离席 -->
                <StackPanel x:Name="LegacyRightBottomHudStack"
                            Orientation="Horizontal"
                            Canvas.Left="370"
                            Canvas.Bottom="12"
                            Panel.ZIndex="100">
                    <Button x:Name="GroundbaitButton" Style="{StaticResource CozyInteractionButton}" local:CozyInteractionGlyph.Kind="bait" local:CozyTheme.Icon="cozy/icons-light/leaf.png"
                            Content="打窝"
                            Width="112"
                            Height="40"
                            FontSize="13"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="Groundbait_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.groundbait" />
                    <TextBlock x:Name="GroundbaitStatusText"
                               Width="100"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource CozyInk}"
                               FontSize="11"
                               Margin="0,0,8,0"
                               Visibility="Collapsed" />
                    <Button x:Name="FishingToggleButton" local:CozyTheme.Icon="cozy/icons-light/rod.png"
                            Content="开始钓鱼"
                            Width="88"
                            Height="36"
                            FontSize="13"
                            Margin="0,0,8,0"
                            Click="FishingToggle_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.start_fishing" />
                    <Button x:Name="CatchLeaveButton" local:CozyTheme.Icon="cozy/icons-light/gift.png"
                            Content="离席"
                            Width="88"
                            Height="36"
                            FontSize="13"
                            Click="CatchLeave_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.leave_seat" />
                </StackPanel>
                <!-- Z100: 可收缩公屏聊天窗（合并预览 + 输入） -->
                <Border x:Name="ChatDockChrome"
                        Canvas.Left="8"
                        Canvas.Top="508"
                        Width="320"
                        Panel.ZIndex="100"
                        local:CozyTheme.IsPaper="True"
                        CornerRadius="8"
                        Padding="8,6"
                        PreviewMouseLeftButtonDown="ChatInput_OnPreviewMouseLeftButtonDown">
                    <StackPanel>
                        <Grid Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ChatLatestPreview"
                                       Text="暂无公屏消息"
                                       Foreground="{StaticResource CozyInk}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0"
                                       TextTrimming="CharacterEllipsis"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.empty.public_messages" />
                            <Button x:Name="ChatDockToggle" local:CozyTheme.Icon="cozy/icons-light/social.png"
                                    Grid.Column="1"
                                    Content="" ToolTip="展开聊天"
                                    Width="28"
                                    Height="24"
                                    Padding="0"
                                    Click="ChatDockToggle_OnClick"  local:OverlayLocalization.ToolTipKey="ui.fishing.overlay.fallback.tooltip.expand_chat" />
                        </Grid>
                        <ScrollViewer x:Name="ChatLogScroll"
                                      Height="96"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <StackPanel x:Name="ChatLogList" />
                        </ScrollViewer>
                        <ScrollBar x:Name="ChatLogScrollBar"
                                   Style="{StaticResource HudChatScrollBarStyle}"
                                   Orientation="Vertical"
                                   Visibility="Collapsed"
                                   Width="6" />
                        <Border x:Name="ChatInputPanel"
                                Visibility="Collapsed"
                                Width="231"
                                Height="37" />
                        <Grid x:Name="ChatDockExpanded" Visibility="Collapsed" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="ChatInputBox"
                                         MaxLength="200"
                                         AcceptsReturn="False"
                                         TextWrapping="NoWrap"
                                         MinHeight="36"
                                         Height="36"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         Foreground="{StaticResource CozyInk}"
                                         CaretBrush="{StaticResource CozyInk}"
                                         BorderThickness="0"
                                         Padding="8,4"
                                         TextChanged="ChatInputBox_OnTextChanged"
                                         KeyDown="ChatInputBox_OnKeyDown" />
                                <TextBlock x:Name="ChatPlaceholder"
                                           Text="说点什么…"
                                           Foreground="{StaticResource CozyInk}"
                                           IsHitTestVisible="False"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="8,0"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.placeholder.chat_message" />
                            </Grid>
                            <Button x:Name="ChatSendButton" local:CozyTheme.Icon="cozy/icons-light/check.png"
                                    Grid.Column="1"
                                    Content="发送"
                                    Width="64"
                                    Height="36"
                                    Margin="6,0,0,0"
                                    IsEnabled="False"
                                    Click="ChatSend_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.send_chat" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Canvas>
        </Border>
        <Border x:Name="OverlayPromptChrome"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="320"
                Visibility="Collapsed"
                local:CozyTheme.IsPaper="True"
                CornerRadius="16"
                Padding="22,20"
                Panel.ZIndex="300">
            <StackPanel>
                <TextBlock x:Name="OverlayPromptTitle"
                           Text=""
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource CozyInk}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="OverlayPromptBody"
                           Text=""
                           FontSize="14"
                           Foreground="{StaticResource CozyInk}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0"
                           LineHeight="22" />
                <TextBlock x:Name="OverlayPromptCountdown"
                           Text=""
                           FontSize="12"
                           Foreground="{StaticResource CozyInk}"
                           TextAlignment="Center"
                           Margin="0,12,0,0" />
                <Button x:Name="OverlayPromptButton"
                        Content="确认"
                        Height="40"
                        Margin="40,16,40,0"
                        Click="OverlayPromptConfirm_OnClick"  local:OverlayLocalization.Key="ui.fishing.overlay.fallback.button.confirm_prompt" />
            </StackPanel>
        </Border>
        <!-- Z500: 玩法 Debug 顶层模态弹窗（盖住场景与其它提示）STEAM-DESKTOP-12B -->
        <Grid x:Name="GameplayDebugModal"
              Visibility="Collapsed"
              Panel.ZIndex="500"
              Background="#4075472E"
              MouseLeftButtonDown="GameplayDebugModalDim_OnMouseLeftButtonDown">
            <Border Width="560"
                    MaxHeight="360"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="8"
                    local:CozyTheme.IsPaper="True"
                    BorderBrush="{StaticResource CozyInk}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12"
                    MouseLeftButtonDown="GameplayDebugModalPanel_OnMouseLeftButtonDown">
                <Grid>
                    <!-- 默认：动作按钮三列平铺 -->
                    <DockPanel x:Name="GameplayDebugMainPage">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Height="32">
                            <TextBlock Text="玩法 Debug"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CozyInk}"
                                       VerticalAlignment="Center" />
                            <Button Content="关闭"
                                    Width="64"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="GameplayDebugClose_OnClick" />
                        </Grid>
                        <TextBlock x:Name="GameplayDebugStatusText"
                                   DockPanel.Dock="Top"
                                   Margin="2,0,2,8"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource CozyInk}"
                                   Text="点击按钮执行，结果显示在这里。" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <UniformGrid Columns="3">
                                <Button Content="升级" Height="34" Margin="2" Click="GameplayDebugLevelUp_OnClick" />
                                <Button Content="升至满级" Height="34" Margin="2" Click="GameplayDebugLevelMax_OnClick" />
                                <Button Content="塘熟练度 +1" Height="34" Margin="2" Click="GameplayDebugPondUp_OnClick" />
                                <Button Content="塘熟练度满级" Height="34" Margin="2" Click="GameplayDebugPondMax_OnClick" />
                                <Button Content="+100万金币" Height="34" Margin="2" Click="GameplayDebugGold_OnClick" />
                                <Button Content="一键出警" Height="34" Margin="2" Click="PoliceDebug_OnClick" />
                                <Button Content="立即收杆" Height="34" Margin="2" Click="GameplayDebugCompleteCatch_OnClick" />
                                <Button Content="钓获传说" Height="34" Margin="2" Click="GameplayDebugCatchRed_OnClick" />
                                <Button Content="钓获神话" Height="34" Margin="2" Click="GameplayDebugCatchOrange_OnClick" />
                                <Button Content="钓获至尊" Height="34" Margin="2" Click="GameplayDebugCatchGold_OnClick" />
                                <Button Content="获得鱼获(入包)" Height="34" Margin="2" Click="GameplayDebugFish_OnClick" ToolTip="跳过钓鱼，仅测背包" />
                                <Button Content="最大尺寸(入包)" Height="34" Margin="2" Click="GameplayDebugFishMax_OnClick" ToolTip="跳过钓鱼，仅测背包" />
                                <Button Content="钓鱼时长 +2h" Height="34" Margin="2" Click="GameplayDebugFee_OnClick" />
                                <Button Content="重置钓鱼时长" Height="34" Margin="2" Click="GameplayDebugResetDuration_OnClick" />
                                <Button Content="查看鱼塘的鱼" Height="34" Margin="2" Click="GameplayDebugListPondFish_OnClick" />
                                <Button Content="查看钓位的鱼" Height="34" Margin="2" Click="GameplayDebugListSpotFish_OnClick" />
                                <Button Content="查看钓位数据" Height="34" Margin="2" Click="GameplayDebugSpotStats_OnClick" />
                            </UniformGrid>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- 查看页：覆盖默认页，条目三列按钮 -->
                    <Grid x:Name="GameplayDebugInspectPage" Visibility="Collapsed">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10" Height="32">
                                <Button x:Name="GameplayDebugInspectBackButton" local:CozyTheme.Icon="cozy/icons-light/home.png"
                                        Content="返回"
                                        Width="72"
                                        Height="28"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Click="GameplayDebugInspectBack_OnClick" />
                                <TextBlock x:Name="GameplayDebugInspectTitle"
                                           Text="查看"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource CozyInk}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Button Content="关闭"
                                        Width="64"
                                        Height="28"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="GameplayDebugClose_OnClick" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,0">
                                    <UniformGrid x:Name="GameplayDebugInspectButtonGrid" Columns="3" />
                                </ScrollViewer>
                                <!-- 右侧详情小弹窗 -->
                                <Border x:Name="GameplayDebugDetailFlyout" Grid.Column="1"
                                        Visibility="Collapsed"
                                        Width="196"
                                        MaxHeight="360"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Margin="4,0,0,0"
                                        local:CozyTheme.IsPaper="True"
                                        BorderBrush="{StaticResource CozyInk}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                            <TextBlock x:Name="GameplayDebugDetailFlyoutTitle"
                                                       Text="详情"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource CozyInk}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="关闭"
                                                    Width="42"
                                                    Height="24"
                                                    HorizontalAlignment="Right"
                                                    Padding="0"
                                                    Click="GameplayDebugDetailFlyoutClose_OnClick" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <Button x:Name="GameplayDebugForceBiteButton"
                                                    Content="强制上钩"
                                                    Height="30"
                                                    Margin="0,0,0,4"
                                                    Visibility="Collapsed"
                                                    Click="GameplayDebugForceBite_OnClick" />
                                            <Button x:Name="GameplayDebugInstantCatchFishButton"
                                                    Content="钓获该鱼"
                                                    Height="30"
                                                    Visibility="Collapsed"
                                                    Click="GameplayDebugCatchFish_OnClick" />
                                        </StackPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="GameplayDebugDetailFlyoutText"
                                                       Foreground="{StaticResource CozyInk}"
                                                       TextWrapping="Wrap"
                                                       FontSize="12"
                                                       LineHeight="18" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
