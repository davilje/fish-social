<Window x:Class="FishSocialOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fish Social Overlay"
        Width="960"
        Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Grid Background="Transparent">
        <Border x:Name="PondScene"
                Width="960"
                Height="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="18"
                ClipToBounds="True"
                MouseLeftButtonDown="PondScene_OnMouseLeftButtonDown"
                MouseMove="PondScene_OnMouseMove"
                MouseLeftButtonUp="PondScene_OnMouseLeftButtonUp">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="当前鱼塘" Click="MenuPond_OnClick" />
                    <MenuItem Header="好友与聊天" Click="MenuFriends_OnClick" />
                    <MenuItem Header="鱼获/背包" Click="MenuCatch_OnClick" />
                    <MenuItem Header="图鉴" Click="MenuGallery_OnClick" />
                    <MenuItem Header="设置" Click="MenuSettings_OnClick" />
                    <Separator />
                    <MenuItem Header="隐藏到托盘" Click="HideToTray_OnClick" />
                    <MenuItem Header="退出" Click="QuitApp_OnClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <Canvas x:Name="SceneCanvas" Width="960" Height="480">
                <Image x:Name="PondBackgroundImage"
                       Width="960"
                       Height="480"
                       Stretch="UniformToFill"
                       Visibility="Collapsed" />
                <Rectangle x:Name="GrassLayer"
                           Width="960"
                           Height="480"
                           Fill="#E62F4A3A" />
                <Ellipse x:Name="ShoreLayer"
                         Width="760"
                         Height="340"
                         Canvas.Left="100"
                         Canvas.Top="70"
                         Fill="#CC8B6A45" />
                <Ellipse x:Name="WaterLayer"
                         Width="700"
                         Height="300"
                         Canvas.Left="130"
                         Canvas.Top="90"
                         Fill="#CC2A6F8F" />
                <Canvas x:Name="SpotLayer" Width="960" Height="480" />
                <Viewbox x:Name="OwnCat"
                         Width="128"
                         Height="128"
                         Canvas.Left="416"
                         Canvas.Top="280"
                         Stretch="Uniform">
                    <Canvas Width="220" Height="220">
                        <Polygon x:Name="CatEarL"
                                 Points="48,70 68,18 103,62"
                                 Fill="#FF4D89A8"
                                 Stroke="#FFB8E1EF"
                                 StrokeThickness="3" />
                        <Polygon x:Name="CatEarR"
                                 Points="117,62 152,18 172,70"
                                 Fill="#FF4D89A8"
                                 Stroke="#FFB8E1EF"
                                 StrokeThickness="3" />
                        <Ellipse x:Name="CatBody"
                                 Width="150"
                                 Height="145"
                                 Canvas.Left="35"
                                 Canvas.Top="52"
                                 Fill="#FF4D89A8"
                                 Stroke="#FFB8E1EF"
                                 StrokeThickness="3" />
                        <Ellipse Width="16" Height="22"
                                 Canvas.Left="76"
                                 Canvas.Top="102"
                                 Fill="#FF16212B" />
                        <Ellipse Width="16" Height="22"
                                 Canvas.Left="128"
                                 Canvas.Top="102"
                                 Fill="#FF16212B" />
                        <Ellipse Width="12" Height="8"
                                 Canvas.Left="104"
                                 Canvas.Top="139"
                                 Fill="#FFF3C969" />
                    </Canvas>
                </Viewbox>
                <Image x:Name="OwnCatImage"
                       Width="128"
                       Height="128"
                       Stretch="Uniform"
                       Visibility="Collapsed" />
                <Canvas x:Name="ActorLayer" Width="960" Height="480" />
                <Border Canvas.Left="16"
                        Canvas.Top="12"
                        Background="#990F1820"
                        CornerRadius="10"
                        Padding="10,6">
                    <StackPanel>
                        <TextBlock x:Name="StateText"
                                   Text="状态：等待主界面"
                                   Foreground="White"
                                   FontSize="16" />
                        <TextBlock x:Name="PondText"
                                   Text="鱼塘：未连接"
                                   Foreground="#FFD4E3EA"
                                   FontSize="13"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="SpotText"
                                   Text="钓位：未选择"
                                   Foreground="#FFD4E3EA"
                                   FontSize="13"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
                <Button Content="打开主界面"
                        Width="120"
                        Height="30"
                        Canvas.Left="820"
                        Canvas.Top="16"
                        Click="OpenMain_OnClick" />
            </Canvas>
        </Border>
    </Grid>
</Window>
